<Window x:Class="SELLCT.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="SELLCT" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="LightGray"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- アニメーション用ストーリーボード -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="0" To="1" Duration="0:0:1"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                            From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>



        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- スタイル定義 -->
        <Style x:Key="PixelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="DarkGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogWindowStyle" TargetType="Border">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="5"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="427*"/>
            <ColumnDefinition Width="370*"/>
        </Grid.ColumnDefinitions>
        <!-- 背景画像（常時表示） -->
        <Image Name="BackgroundImage" 
               Source="/Resources/Background.png" 
               Stretch="Fill"
               Panel.ZIndex="0" Grid.ColumnSpan="3"/>

        <!-- メインゲーム領域 -->
        <Canvas Name="GameCanvas" Panel.ZIndex="1" Grid.ColumnSpan="3">

            <Button Name="MainButton" 
                    Content="?" 
                    Style="{StaticResource PixelButtonStyle}"
                    Width="200" Height="59" Canvas.Top="504"
                    Click="MainButton_Click"
                    Visibility="Visible" HorizontalAlignment="Left" VerticalAlignment="Top" Canvas.Left="57"/>

            <!--手紙画像 -->
            <Image Name="LetterImage" 
                   Source="/Resources/Letter.png"
                   Width="60" Height="80"
                   Canvas.Left="100" Canvas.Top="350"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="Letter_Click"
                   Cursor="Hand"
                   Panel.ZIndex="2">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!--：KEY画像 -->
            <Image Name="KeyImage" 
                   Source="/Resources/KEY.png"
                   Width="60" Height="60"
                   Canvas.Left="124" Canvas.Top="470"
                   Visibility="Collapsed"
                   MouseLeftButtonDown="Key_Click"
                   Cursor="Hand"
                   Panel.ZIndex="2"/>

            <!--：対話ウィンドウ -->
            <Border Name="DialogWindow" 
                    Style="{StaticResource DialogWindowStyle}"
                    Width="450" Height="90"
                    Canvas.Left="350" Canvas.Top="488"
                    Visibility="Collapsed"
                    Panel.ZIndex="3" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28*"/>
                        <ColumnDefinition Width="489*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="11*"/>
                        <RowDefinition Height="48*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- メッセージテキスト -->
                    <TextBlock Name="DialogText" 
                               TextWrapping="Wrap"
                               FontSize="16"
                               LineHeight="16"
                               Margin="15,5,15,5"
                               Foreground="White" Grid.RowSpan="4" Grid.ColumnSpan="2"/>

                    <!-- 選択肢ボタン -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="15,0,15,15"
                                Grid.Row="2">
                        <Button Name="YesButton" 
                                Content="はい" 
                                Style="{StaticResource PixelButtonStyle}"
                                Width="60" Height="30"
                                Margin="5,0"
                                Visibility="Collapsed"
                                Click="YesButton_Click"/>
                        <Button Name="NoButton" 
                                Content="いいえ" 
                                Style="{StaticResource PixelButtonStyle}"
                                Width="60" Height="30"
                                Margin="5,0"
                                Visibility="Collapsed"
                                Click="NoButton_Click"/>
                    </StackPanel>

                    <!-- クリックイベントを捕捉するための透明なボタン -->
                    <!-- GlobalClickCatcherが全体をカバーするため、ここでは不要 -->
                </Grid>
            </Border>
        </Canvas>

        <!-- デバッグ情報パネル（開発時のみ表示） -->
        <Border Background="Black" 
                Opacity="0.8"
                Width="250" Height="120"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="7,0,0,10"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Name="DebugPanel" Grid.Column="1">
            <StackPanel Margin="10">
                <TextBlock Text="SELLCT Debug Info" 
                           Foreground="Lime" 
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           FontSize="12"/>
                <TextBlock Name="DebugText" 
                           Foreground="Lime" 
                           FontFamily="Consolas"
                           FontSize="10"
                           Text="State: #x0a;Components: 5&#x0a;Letters: 0/6&#x0a;Phase: 1"/>
            </StackPanel>
        </Border>

        <!-- 状態表示（右下） -->
        <StackPanel HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,10,10"
                    Panel.ZIndex="5" Grid.Column="2">
            <TextBlock Name="StatusText" 
                       Text="SELLCT 起動中..."
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="DarkGray"
                       HorizontalAlignment="Right"/>
            <TextBlock Name="ComponentCountText" 
                       Text="構成要素: 5"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="DarkGray"
                       HorizontalAlignment="Right"/>
        </StackPanel>

        <!-- ローディングオーバーレイ -->
        <Grid Name="LoadingOverlay" 
              Background="Black" 
              Opacity="0.8"
              Panel.ZIndex="1000"
              Visibility="Collapsed" Grid.ColumnSpan="3">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                <TextBlock Text="SELLCT" 
                           Foreground="White"
                           FontSize="48"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                <TextBlock Text="システム初期化中..." 
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                <ProgressBar Width="200" 
                             Height="10"
                             Margin="0,20,0,0"
                             IsIndeterminate="True"/>
            </StackPanel>
        </Grid>

        <!-- グローバルクリックキャッチャー -->
        <Button Name="GlobalClickCatcher" 
                Style="{StaticResource TransparentButtonStyle}"
                Background="Transparent" 
                BorderBrush="Transparent"
                Click="GlobalClickCatcher_Click"
                Panel.ZIndex="999" 
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" Grid.ColumnSpan="3"/>
    </Grid>
</Window>